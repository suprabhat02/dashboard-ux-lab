---
/**
 * "About the author", at the top of every page's footer.
 *
 * The profile links carry rel="me", which lets search engines and identity
 * services connect this site with the same person elsewhere; the matching
 * Person node is in the page's JSON-LD (src/site/seo.ts).
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/author/portrait.avif';
import { pageI18n } from '../site/i18n';
import { AUTHOR } from '../site/seo';
import type { Locale } from '../spec/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = pageI18n(locale);
const a = t.author;
const links = [
  { label: a.portfolio, href: AUTHOR.url },
  { label: 'GitHub', href: AUTHOR.github },
  { label: 'X', href: AUTHOR.x },
];
---

<section class="author" aria-labelledby="author-title">
  <Picture
    src={portrait}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    width={96}
    height={96}
    widths={[96, 192]}
    sizes="96px"
    alt={a.portraitAlt}
    class="author__photo"
    loading="lazy"
    decoding="async"
  />
  <div class="author__id">
    <h2 class="author__name" id="author-title">
      <span class="sr-only">{a.title}: </span>
      {a.name}
    </h2>
    <p class="author__role">{a.role}</p>
  </div>
  <div class="author__bio">
    <p>{a.bio}</p>
    <p>{a.bio2}</p>
  </div>
  <nav class="author__links" aria-label={a.links}>
    <ul role="list">
      {links.map((link) => (
        <li>
          <a href={link.href} rel="me author">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>
