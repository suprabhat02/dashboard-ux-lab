---
/**
 * Numbered section heading for the home page. The index is decorative (the
 * document outline comes from the h2), so it is hidden from assistive tech.
 */
interface Props {
  id: string;
  index: number;
  title: string;
  intro?: string;
}

const { id, index, title, intro } = Astro.props;
const label = String(index).padStart(2, '0');
---

<header class="shead reveal">
  <span class="shead__index" aria-hidden="true">
    {label}
  </span>
  <h2 class="shead__title" id={id}>
    {title}
  </h2>
  {intro && <p class="shead__intro">{intro}</p>}
</header>
