---
/** Section heading for the home page: an h2 and an optional introduction. */
interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<header class="shead">
  <h2 class="shead__title" id={id}>
    {title}
  </h2>
  {intro && <p class="shead__intro">{intro}</p>}
</header>
