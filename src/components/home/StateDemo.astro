---
/**
 * The hero's request console: one dashboard, the six scenarios, and a time ruler
 * that shows when each rule of the spec fires (placeholders at 300 ms, "slow" at
 * 3 s, Cancel at 8 s) and where each scenario's response lands.
 *
 * Accessibility (APG "tabbed carousel"):
 * - The miniature dashboard and the ruler are decorative (aria-hidden); every
 *   state is described in words by the matching tab panel.
 * - Rotation is opt-out (Pause control, WCAG 2.2.2), never starts under
 *   prefers-reduced-motion, pauses while the widget has focus or the pointer,
 *   and stops for good once the visitor picks a state.
 * - Without JavaScript, the first state renders as static content and the
 *   controls are hidden.
 */
import Icon from '../Icon.astro';
import { buildDashboard, CURRENT_MONTH } from '../../spec/data';
import { getFormatter } from '../../spec/format';
import { LOCALE_META, type Locale } from '../../spec/i18n';
import { pageI18n } from '../../site/i18n';
import { SCENARIOS } from '../../spec/scenarios';
import { TIMING } from '../../spec/timing';
import type { ScenarioId } from '../../spec/types';
import { REPRESENTATIVE, RULER_MAX_MS, rulerPosition } from '../../site/ruler';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, href } = pageI18n(locale);
const demo = t.home.demo;
const fmt = getFormatter(locale);
const data = buildDashboard('all', 'analyst');
const kpis = data.kpis.slice(0, 3);
const peak = Math.max(...data.revenue.map((point) => point.mrr));
const bars = data.revenue.map((point) => (point.mrr / peak).toFixed(3));
const first: ScenarioId = SCENARIOS[0]?.id ?? 'loaded';
const firstRep = REPRESENTATIVE[first];

const intl = LOCALE_META[locale].intl;
const ms = new Intl.NumberFormat(intl, {
  style: 'unit',
  unit: 'millisecond',
  unitDisplay: 'narrow',
});
const s = new Intl.NumberFormat(intl, {
  style: 'unit',
  unit: 'second',
  unitDisplay: 'narrow',
});
const duration = (value: number): string =>
  value < 1000 ? ms.format(value) : s.format(value / 1000);

const marks = [
  { at: TIMING.skeletonDelayMs, label: demo.ruler.skeleton },
  { at: TIMING.slowAfterMs, label: demo.ruler.slow },
  { at: TIMING.stalledAfterMs, label: demo.ruler.cancel },
] as const;
const pos = (value: number): string => rulerPosition(value).toFixed(4);
---

<div
  class="console"
  data-demo
  data-label-play={demo.play}
  data-label-pause={demo.pause}
  style={`--t: ${pos(firstRep.atMs)}; --resp: ${pos(SCENARIOS[0]?.settings.latencyMs ?? 0)}`}
>
  <div class="demo__layout">
    <div class="console__screen">
      <div
        class="mock"
        aria-hidden="true"
        data-demo-mock
        data-state={first}
        data-phase={firstRep.phase}
      >
        <div class="mock__bar">
          <Icon name="logo" size={16} />
          <span class="mock__company">{t.dashboard.company}</span>
          <span class="mock__month">{fmt.monthLong(CURRENT_MONTH)}</span>
        </div>
        <div class="mock__body">
          <div class="mock__kpis">
            {kpis.map((kpi) => (
              <div class="mock__kpi">
                <span class="mock__label">{t.dashboard.kpi[kpi.id]}</span>
                <span class="mock__value">
                  <span class="mock__number">{fmt.value(kpi.value, kpi.format)}</span>
                  <span class="mock__dash">—</span>
                </span>
              </div>
            ))}
          </div>
          <div class="mock__chart">
            <div class="mock__bars">
              {bars.map((height) => (
                <span class="mock__col" style={`--h: ${height}`} />
              ))}
            </div>
            <p class="mock__notice" data-for="slow">
              <Icon name="slow" size={16} />
              <span>{t.dashboard.loading.slowTitle}</span>
            </p>
            <p class="mock__notice" data-for="cancel">
              <Icon name="slow" size={16} />
              <span>{t.dashboard.loading.stalledTitle}</span>
              <span class="mock__fake-btn mock__fake-btn--quiet">
                {t.dashboard.loading.cancel}
              </span>
            </p>
            {(['empty', 'error', 'restricted'] as const).map((state) => (
              <div class="mock__overlay" data-for={state}>
                <Icon name={state} size={28} />
                <span class="mock__overlay-title">{t.scenarios[state].title}</span>
                {state === 'error' && (
                  <span class="mock__fake-btn">
                    <Icon name="retry" size={14} />
                    {t.dashboard.error.retry}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="console__side">
      <div class="demo__controls" data-demo-controls>
        <div class="demo__tabs" role="tablist" aria-label={demo.controlsLabel}>
          {SCENARIOS.map((scenario) => (
            <button
              class="demo__tab"
              type="button"
              role="tab"
              id={`demo-tab-${scenario.id}`}
              aria-controls={`demo-panel-${scenario.id}`}
              aria-selected={scenario.id === first ? 'true' : 'false'}
              tabindex={scenario.id === first ? 0 : -1}
              data-state={scenario.id}
              data-latency={scenario.settings.latencyMs}
              data-rep-phase={REPRESENTATIVE[scenario.id].phase}
              data-rep-at={REPRESENTATIVE[scenario.id].atMs}
            >
              <Icon name={scenario.id} size={18} />
              <span class="demo__tab-title">{t.scenarios[scenario.id].title}</span>
              <span class="demo__tab-time">{duration(scenario.settings.latencyMs)}</span>
            </button>
          ))}
        </div>
        <button
          class="demo__toggle"
          type="button"
          data-demo-toggle
          aria-label={demo.play}
        >
          <Icon name="pause" size={18} class="demo__icon-pause" />
          <Icon name="play" size={18} class="demo__icon-play" />
        </button>
      </div>

      <div class="demo__panels" data-demo-panels aria-live="polite">
        {SCENARIOS.map((scenario) => (
          <div
            class="demo__panel"
            role="tabpanel"
            id={`demo-panel-${scenario.id}`}
            aria-labelledby={`demo-tab-${scenario.id}`}
            hidden={scenario.id !== first}
          >
            <p class="demo__caption">{demo.captions[scenario.id]}</p>
            <a class="link-arrow" href={`${href('/lab/react/')}?scenario=${scenario.id}`}>
              {demo.openInLab}
              <span class="sr-only">: {t.scenarios[scenario.id].title}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="ruler" aria-hidden="true">
    <p class="ruler__label">{demo.ruler.label}</p>
    <div class="ruler__scale">
      <span class="ruler__track"></span>
      <span class="ruler__fill"></span>
      <span class="ruler__response">
        <span>{demo.ruler.response}</span>
      </span>
      <span class="ruler__head"></span>
      {marks.map((mark) => (
        <span class="ruler__mark" style={`--x: ${pos(mark.at)}`}>
          <span class="ruler__time">{duration(mark.at)}</span>
          <span class="ruler__meaning">{mark.label}</span>
        </span>
      ))}
      <span class="ruler__mark ruler__mark--end" style="--x: 1">
        <span class="ruler__time">{duration(RULER_MAX_MS)}</span>
      </span>
      <span class="ruler__mark ruler__mark--start" style="--x: 0">
        <span class="ruler__time">{duration(0)}</span>
      </span>
    </div>
  </div>

  <noscript>
    <style>
      [data-demo-controls] {
        display: none;
      }
    </style>
  </noscript>
</div>
