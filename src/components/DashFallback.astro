---
/**
 * Server-rendered placeholder for the dashboard while the implementation's
 * script loads. It emits the same markup contract as the live dashboard, so the
 * hand-over is a content swap with no layout shift.
 */
import { COPY } from '../spec/copy';

const skeletonWidths = [62, 48, 58, 44];
const barHeights = [48, 52, 55, 55, 62, 64, 62, 82, 80, 81, 82, 80];
---

<section class="dash" aria-labelledby="dash-fallback-title" data-view="booting">
  <header class="dash__header">
    <div>
      <p class="dash__company">{COPY.company}</p>
      <h2 class="dash__title" id="dash-fallback-title">
        {COPY.dashboardTitle}
      </h2>
      <p class="dash__subtitle">{COPY.dashboardSubtitle}</p>
    </div>
    <label class="dash__filter">
      {COPY.filter.label}
      <select class="select" disabled>
        <option>All plans</option>
      </select>
    </label>
  </header>
  <div class="dash__content" data-reserve>
    <div class="dash__grid">
      <ul class="kpis" role="list">
        {skeletonWidths.map((width) => (
          <li class="kpi">
            <span class="skeleton skeleton--text" style={`--w:${width}%`} />
            <span class="skeleton skeleton--value" />
            <span class="skeleton skeleton--pill" />
          </li>
        ))}
      </ul>
      <section class="widget">
        <div class="widget__header">
          <h3 class="widget__title">{COPY.widgets.revenue}</h3>
        </div>
        <div class="widget__body">
          <div class="skeleton-chart">
            {barHeights.map((height) => (
              <span class="skeleton" style={`--h:${height}%`} />
            ))}
          </div>
        </div>
      </section>
      <section class="widget">
        <div class="widget__header">
          <h3 class="widget__title">{COPY.widgets.accounts}</h3>
        </div>
        <div class="widget__body">
          <div class="table-scroll table-scroll--fixed"></div>
        </div>
      </section>
    </div>
  </div>
  <noscript>
    <p class="state">
      This interactive dashboard needs JavaScript. The scenario guides work without it.
    </p>
  </noscript>
</section>
