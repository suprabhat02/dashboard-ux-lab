---
/**
 * Renders a Lucide icon from spec/icons.ts. Decorative by default (aria-hidden);
 * pass `label` only when the icon is the sole content of a control.
 */
import { DIRECTIONAL_ICONS, ICONS, type IconName } from '../spec/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const node = ICONS[name];
const classes = [className, DIRECTIONAL_ICONS.has(name) ? 'icon-flip' : undefined]
  .filter(Boolean)
  .join(' ');
---

<svg
  class={classes || undefined}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  {node.map(([Tag, attrs]) => (
    <Tag {...attrs} />
  ))}
</svg>
