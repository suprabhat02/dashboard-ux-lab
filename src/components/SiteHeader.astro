---
/**
 * Site header: one row on every screen width and in every language.
 * Wide screens show the section links inline; narrow screens move them into a
 * Menu dropdown. Language and theme are always dropdowns.
 */
import { LOCALE_META, type Locale } from '../spec/i18n';
import type { IconName } from '../spec/icons';
import { alternatesFor, pageI18n } from '../site/i18n';
import HeaderMenu from './HeaderMenu.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  section?: 'home' | 'lab' | 'scenarios' | 'accessibility' | undefined;
}

const { locale, section } = Astro.props;
const { t, href } = pageI18n(locale);
const alternates = alternatesFor(Astro.url.pathname);
const repoUrl = 'https://github.com/suprabhat02/dashboard-ux-lab';
const links = [
  { id: 'lab', href: href('/lab/react/'), label: t.nav.lab },
  { id: 'scenarios', href: href('/scenarios/'), label: t.nav.scenarios },
  { id: 'accessibility', href: href('/accessibility/'), label: t.nav.accessibility },
] as const;
const themes: readonly { id: 'light' | 'dark' | 'system'; icon: IconName }[] = [
  { id: 'light', icon: 'sun' },
  { id: 'dark', icon: 'moon' },
  { id: 'system', icon: 'system' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={href('/')} aria-label={t.nav.homeLabel}>
      <Icon name="logo" size={22} class="wordmark__icon" />
      <span class="wordmark__text" lang="en" dir="ltr">
        Dashboard UX Lab
      </span>
    </a>

    <nav class="site-nav" aria-label={t.nav.main} data-site-nav>
      <span class="site-nav__pill" aria-hidden="true"></span>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={section === link.id ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={repoUrl}>{t.nav.github}</a>
        </li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <HeaderMenu id="menu-nav" label={t.nav.menu} icon="menu" class="menu--nav">
        <nav aria-label={t.nav.main}>
          <ul class="menu__list" role="list">
            {links.map((link) => (
              <li>
                <a
                  class="menu__item"
                  href={link.href}
                  aria-current={section === link.id ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
            <li>
              <a class="menu__item" href={repoUrl}>
                {t.nav.github}
              </a>
            </li>
          </ul>
        </nav>
      </HeaderMenu>

      <HeaderMenu
        id="menu-language"
        label={`${t.nav.language}: ${LOCALE_META[locale].label}`}
        icon="language"
        text={LOCALE_META[locale].short}
      >
        <ul class="menu__list" role="list">
          {alternates.map((alt) => (
            <li>
              <a
                class="menu__item"
                href={alt.href}
                hreflang={LOCALE_META[alt.locale].htmlLang}
                lang={LOCALE_META[alt.locale].htmlLang}
                dir={LOCALE_META[alt.locale].dir}
                aria-current={alt.locale === locale ? 'true' : undefined}
                data-locale-link
              >
                <span>{LOCALE_META[alt.locale].label}</span>
                {alt.locale === locale && (
                  <Icon name="check" size={16} class="menu__check" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </HeaderMenu>

      <div class="theme-menu" data-theme-menu data-current="system">
        <HeaderMenu id="menu-theme" label={t.nav.theme} icon="system">
          <Fragment slot="icon">
            {themes.map((theme) => (
              <Icon
                name={theme.icon}
                size={18}
                class={`menu__icon theme-icon theme-icon--${theme.id}`}
              />
            ))}
          </Fragment>
          <ul class="menu__list" role="list">
            {themes.map((theme) => (
              <li>
                <button
                  class="menu__item"
                  type="button"
                  aria-pressed="false"
                  data-theme-option={theme.id}
                >
                  <Icon name={theme.icon} size={16} />
                  <span>{t.nav.themes[theme.id]}</span>
                  <Icon name="check" size={16} class="menu__check" />
                </button>
              </li>
            ))}
          </ul>
        </HeaderMenu>
      </div>
    </div>
  </div>
</header>

<script>
  import '../site/menus';
</script>

<script>
  import { initHeader } from '../site/header';
  initHeader();
</script>
