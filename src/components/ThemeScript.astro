---
/**
 * Runs before first paint (inline, blocking, tiny) so a stored theme never
 * flashes. No stored choice → no attribute → CSS follows prefers-color-scheme.
 */
---

<script is:inline>
  try {
    var t = localStorage.getItem('dux-theme');
    if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
  } catch (_) {}
  document.documentElement.classList.add('js');
</script>
