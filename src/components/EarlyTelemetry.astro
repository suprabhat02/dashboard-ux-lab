---
/**
 * Holds lab telemetry emitted before any module script runs. Inline and blocking,
 * so it listens before a build can speak: a React island is fetched with import()
 * as soon as the parser reaches it, and the vanilla build's script can run before
 * the lab's own. The first consumer takes the buffer (src/lab/early-telemetry.ts).
 */
import { TELEMETRY_EVENT } from '../spec/protocol';
---

<script is:inline define:vars={{ type: TELEMETRY_EVENT }}>
  (function () {
    if (window.__duxEarly) return;
    var events = [];
    var keep = function (event) {
      events.push(event.detail);
    };
    window.addEventListener(type, keep);
    window.__duxEarly = {
      events: events,
      stop: function () {
        window.removeEventListener(type, keep);
      },
    };
  })();
</script>
