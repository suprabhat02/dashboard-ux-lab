---
/**
 * Header dropdown (APG "Disclosure" pattern, not role="menu": the panel holds
 * ordinary links and buttons, so Tab works inside it as everywhere else).
 * Behaviour lives in src/site/menus.ts: Escape closes and returns focus, clicking
 * outside or tabbing away closes, opening one menu closes the others.
 */
import type { IconName } from '../spec/icons';
import Icon from './Icon.astro';

interface Props {
  id: string;
  /** Accessible name of the trigger button. */
  label: string;
  icon: IconName;
  /** Short visible text next to the icon (e.g. "EN"). */
  text?: string;
  class?: string;
}

const { id, label, icon, text, class: className } = Astro.props;
---

<div class:list={['menu', className]} data-menu>
  <button
    class="menu__button"
    type="button"
    aria-expanded="false"
    aria-controls={id}
    aria-label={label}
    data-menu-button
  >
    {Astro.slots.has('icon') ? (
      <slot name="icon" />
    ) : (
      <Icon name={icon} size={18} class="menu__icon" />
    )}
    {text && (
      <span class="menu__text" aria-hidden="true">
        {text}
      </span>
    )}
    <Icon name="chevronDown" size={14} class="menu__chevron" />
  </button>
  <div class="menu__panel" id={id} hidden data-menu-panel>
    <slot />
  </div>
</div>
