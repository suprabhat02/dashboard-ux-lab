---
/**
 * The playground chrome shared by both lab pages: scenario controls, the
 * explanation panel and the inspector. The implementation renders into the
 * default slot and never imports anything from here (see spec/protocol.ts).
 *
 * All controls are server-rendered native elements, so the page is readable and
 * navigable before (or without) JavaScript; src/lab/controller.ts enhances them,
 * reading the locale from <html lang>.
 */
import { PLAN_FILTERS } from '../spec/data';
import { getFormatter } from '../spec/format';
import type { Locale } from '../spec/i18n';
import { DEFAULT_SETTINGS, SCENARIOS } from '../spec/scenarios';
import { TIMING } from '../spec/timing';
import type { FailureMode, ImplementationId, Role } from '../spec/types';
import { pageI18n } from '../site/i18n';
import EarlyTelemetry from './EarlyTelemetry.astro';
import Icon from './Icon.astro';
import LabAr from './lab-scripts/LabAr.astro';
import LabEn from './lab-scripts/LabEn.astro';
import LabEs from './lab-scripts/LabEs.astro';
import '../styles/dashboard.css';
import '../styles/lab.css';

interface Props {
  implementation: ImplementationId;
  locale: Locale;
}

const { implementation, locale } = Astro.props;
const { t, href } = pageI18n(locale);
const fmt = getFormatter(locale);
const loaded = t.scenarios.loaded;
const roles: readonly Role[] = ['analyst', 'viewer', 'none'];
const failures: readonly FailureMode[] = ['never', 'once', 'always'];
const implementations: readonly ImplementationId[] = ['react', 'vanilla'];
const seconds = (ms: number) => fmt.integer(ms / 1000);
---

<div class="lab container" data-lab-implementation={implementation}>
  <div class="lab__intro">
    <div>
      <h1 class="lab__title">{t.lab.title}</h1>
      <p class="lab__lede">{t.lab.lede}</p>
    </div>

    <nav class="impl-switch" aria-label={t.lab.implNav}>
      {implementations.map((id) => (
        <a
          class="impl-switch__link"
          href={href(`/lab/${id}/`)}
          data-impl-link={id}
          aria-current={id === implementation ? 'page' : undefined}
        >
          <span class="impl-switch__label">{t.lab.impl[id].label}</span>
          <span class="impl-switch__note">{t.lab.impl[id].note}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="lab__grid">
    <aside class="lab__rail" aria-label={t.lab.controlsLabel}>
      <button
        class="btn lab__rail-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="lab-controls"
        data-rail-toggle
      >
        <span>
          {t.lab.railToggle} <strong data-current-scenario>{loaded.title}</strong>
        </span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>

      <div class="lab__rail-body" id="lab-controls" data-rail-body>
        <section class="panel" aria-labelledby="controls-heading">
          <h2 class="panel__title" id="controls-heading">
            {t.lab.scenarioHeading}
          </h2>
          <form class="controls" data-controls novalidate>
            <fieldset class="presets">
              <legend class="sr-only">{t.lab.presetsLegend}</legend>
              {SCENARIOS.map((scenario) => (
                <label class="preset">
                  <input
                    type="radio"
                    name="scenario"
                    value={scenario.id}
                    checked={scenario.id === 'loaded'}
                  />
                  <span class="preset__body">
                    <span class="preset__title">{t.scenarios[scenario.id].title}</span>
                    <span class="preset__summary">
                      {t.scenarios[scenario.id].summary}
                    </span>
                  </span>
                </label>
              ))}
            </fieldset>

            <details class="tune" open>
              <summary class="tune__summary">
                {t.lab.tune}{' '}
                <span class="tune__custom" data-custom-badge hidden>
                  {t.lab.custom}
                </span>
              </summary>
              <div class="tune__body">
                <div class="field">
                  <div class="field__row">
                    <label for="latency">{t.lab.latency}</label>
                    <output for="latency" class="mono field__value" data-latency-output>
                      {t.lab.ms(fmt.integer(DEFAULT_SETTINGS.latencyMs))}
                    </output>
                  </div>
                  <input
                    class="range"
                    id="latency"
                    name="latency"
                    type="range"
                    min={TIMING.minLatencyMs}
                    max={TIMING.maxLatencyMs}
                    step="100"
                    value={DEFAULT_SETTINGS.latencyMs}
                    aria-describedby="latency-hint"
                  />
                  <p class="field__hint" id="latency-hint">
                    {t.lab.latencyHint(
                      fmt.integer(TIMING.skeletonDelayMs),
                      seconds(TIMING.slowAfterMs),
                      seconds(TIMING.stalledAfterMs),
                    )}
                  </p>
                </div>

                <fieldset class="field segmented">
                  <legend>{t.lab.failureLegend}</legend>
                  <div class="segmented__options">
                    {failures.map((mode) => (
                      <label class="segmented__option">
                        <input
                          type="radio"
                          name="failure"
                          value={mode}
                          checked={mode === DEFAULT_SETTINGS.failure}
                        />
                        <span>{t.lab.failure[mode]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <div class="field field--split">
                  <label class="field__stack">
                    <span>{t.lab.role}</span>
                    <select class="select" name="role">
                      {roles.map((role) => (
                        <option value={role} selected={role === DEFAULT_SETTINGS.role}>
                          {t.dashboard.roles[role]}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="field__stack">
                    <span>{t.lab.planFilter}</span>
                    <select class="select" name="plan">
                      {PLAN_FILTERS.map((plan) => (
                        <option value={plan} selected={plan === DEFAULT_SETTINGS.plan}>
                          {t.dashboard.plans[plan]}
                        </option>
                      ))}
                    </select>
                  </label>
                </div>
              </div>
            </details>

            <div class="controls__actions">
              <button class="btn btn--primary" type="button" data-replay>
                <Icon name="retry" size={16} />
                {t.lab.replay}
              </button>
              <button class="btn" type="button" data-copy-link>
                {t.lab.copyLink}
              </button>
            </div>
            <p class="sr-only" aria-live="polite" data-chrome-status></p>
          </form>
        </section>

        <section class="panel explain" aria-labelledby="explain-heading" data-explain>
          <h2 class="panel__title" id="explain-heading">
            {t.lab.explainHeading}
          </h2>
          <div class="explain__item">
            <h3>{t.lab.explainWhat}</h3>
            <p data-explain-what>{loaded.what}</p>
          </div>
          <div class="explain__item">
            <h3>{t.lab.explainWhy}</h3>
            <p data-explain-why>{loaded.why}</p>
          </div>
          <div class="explain__item">
            <h3>{t.lab.explainA11y}</h3>
            <p data-explain-a11y>{loaded.accessibility}</p>
          </div>
          <a class="explain__more" href={href('/scenarios/loaded/')} data-explain-link>
            {t.lab.readGuide(loaded.title)}
          </a>
        </section>
      </div>
    </aside>

    <div class="lab__stage">
      <div class="stage">
        {/* Listens before the build's own script can speak (vanilla runs first). */}
        <EarlyTelemetry />
        <slot />
      </div>

      {/*
        The request timeline (src/lab/timeline.ts). The lanes are a picture of
        the run (aria-hidden); the scrubber and the readout under it say the same
        in words, so nothing here depends on seeing the lanes.
      */}
      <section class="panel tl" aria-labelledby="tl-heading" data-timeline>
        <div class="tl__head">
          <div class="tl__intro">
            <h2 class="panel__title" id="tl-heading">
              {t.timeline.heading}
            </h2>
            <p class="tl__hint" id="tl-hint">
              {t.timeline.hint}
            </p>
          </div>
          <div class="tl__actions">
            <button
              class="btn btn--sm tl__live"
              type="button"
              aria-pressed="true"
              data-tl-live
            >
              <Icon name="live" size={16} />
              {t.timeline.live}
            </button>
            <button class="btn btn--sm" type="button" data-export-open>
              <Icon name="exportTest" size={16} />
              {t.exportTest.button}
            </button>
          </div>
        </div>

        <div class="tl__plot" aria-hidden="true" data-tl-plot>
          <div class="tl__axis" data-tl-axis></div>
          <span class="tl__label" data-lane="screen">
            {t.timeline.lanes.screen}
          </span>
          <div class="tl__track" data-tl-track="screen"></div>
          <span class="tl__label" data-lane="heard">
            {t.timeline.lanes.heard}
          </span>
          <div class="tl__track" data-tl-track="heard"></div>
          <span class="tl__label" data-lane="focus">
            {t.timeline.lanes.focus}
          </span>
          <div class="tl__track" data-tl-track="focus"></div>
          <div class="tl__playhead">
            <span class="tl__anchor">
              <span class="tl__line"></span>
            </span>
          </div>
        </div>

        <div class="tl__scrub">
          <label class="tl__scrub-label" for="tl-range">
            {t.timeline.scrubLabel}
          </label>
          <div class="tl__scrub-row">
            <div class="tl__steps">
              <button
                class="btn btn--sm btn--icon"
                type="button"
                aria-label={t.timeline.previous}
                title={t.timeline.previous}
                data-tl-step="-1"
              >
                <Icon name="stepBack" size={16} />
              </button>
              <button
                class="btn btn--sm btn--icon"
                type="button"
                aria-label={t.timeline.next}
                title={t.timeline.next}
                data-tl-step="1"
              >
                <Icon name="stepForward" size={16} />
              </button>
            </div>
            <input
              class="tl__range"
              id="tl-range"
              type="range"
              min="0"
              max="1000"
              step="5"
              value="0"
              aria-describedby="tl-hint"
              data-tl-range
            />
          </div>
        </div>

        <div class="tl__moment">
          <p class="tl__now" data-tl-now>
            {t.timeline.waiting}
          </p>
          <dl class="tl__facts">
            <div>
              <dt>{t.timeline.fields.screen}</dt>
              <dd data-tl-fact="screen">—</dd>
            </div>
            <div>
              <dt>{t.timeline.fields.heard}</dt>
              <dd data-tl-fact="heard">—</dd>
            </div>
            <div>
              <dt>{t.timeline.fields.focus}</dt>
              <dd data-tl-fact="focus">—</dd>
            </div>
            <div>
              <dt>{t.timeline.fields.request}</dt>
              <dd data-tl-fact="request">—</dd>
            </div>
          </dl>
        </div>
      </section>

      <dialog class="export" aria-labelledby="export-title" data-export>
        <div class="export__inner">
          <h2 class="export__title" id="export-title">
            {t.exportTest.title}
          </h2>
          <p class="export__body">{t.exportTest.body}</p>
          <div
            class="export__code"
            role="region"
            aria-label={t.exportTest.codeLabel}
            tabindex="0"
          >
            <pre><code dir="ltr" data-export-code></code></pre>
          </div>
          <p class="sr-only" role="status" data-export-status></p>
          <div class="export__actions">
            <button class="btn btn--primary" type="button" data-export-copy>
              <Icon name="copy" size={16} />
              {t.exportTest.copy}
            </button>
            <a class="btn" href="#" download data-export-download>
              <Icon name="download" size={16} />
              {t.exportTest.download}
            </a>
            <button class="btn btn--ghost" type="button" data-export-close>
              {t.exportTest.close}
            </button>
          </div>
        </div>
      </dialog>

      <section class="panel inspector" aria-labelledby="inspector-heading" data-inspector>
        <div class="inspector__head">
          <h2 class="panel__title" id="inspector-heading">
            {t.inspector.heading}
          </h2>
          <div role="tablist" aria-label={t.inspector.tablist} class="tabs">
            <button
              role="tab"
              type="button"
              id="tab-timeline"
              aria-controls="panel-timeline"
              aria-selected="true"
              class="tabs__tab"
            >
              {t.inspector.tabs.timeline}{' '}
              <span class="tabs__count" data-count="timeline">
                0
              </span>
            </button>
            <button
              role="tab"
              type="button"
              id="tab-announce"
              aria-controls="panel-announce"
              aria-selected="false"
              tabindex="-1"
              class="tabs__tab"
            >
              {t.inspector.tabs.announce}{' '}
              <span class="tabs__count" data-count="announce">
                0
              </span>
            </button>
            <button
              role="tab"
              type="button"
              id="tab-focus"
              aria-controls="panel-focus"
              aria-selected="false"
              tabindex="-1"
              class="tabs__tab"
            >
              {t.inspector.tabs.focus}{' '}
              <span class="tabs__count" data-count="focus">
                0
              </span>
            </button>
          </div>
          <button
            class="btn btn--ghost btn--sm inspector__clear"
            type="button"
            data-clear-log
          >
            {t.inspector.clear}
          </button>
        </div>

        <div
          role="tabpanel"
          id="panel-timeline"
          aria-labelledby="tab-timeline"
          tabindex="0"
          class="inspector__panel"
        >
          <p class="inspector__hint">{t.inspector.hints.timeline}</p>
          <div role="log" aria-live="off" aria-label={t.inspector.logLabels.timeline}>
            <ol class="log" data-log="timeline" data-empty={t.inspector.empty}></ol>
          </div>
        </div>
        <div
          role="tabpanel"
          id="panel-announce"
          aria-labelledby="tab-announce"
          tabindex="0"
          class="inspector__panel"
          hidden
        >
          <p class="inspector__hint">{t.inspector.hints.announce}</p>
          <div role="log" aria-live="off" aria-label={t.inspector.logLabels.announce}>
            <ol class="log" data-log="announce" data-empty={t.inspector.empty}></ol>
          </div>
        </div>
        <div
          role="tabpanel"
          id="panel-focus"
          aria-labelledby="tab-focus"
          tabindex="0"
          class="inspector__panel"
          hidden
        >
          <p class="inspector__hint">{t.inspector.hints.focus}</p>
          <p class="focus-now">
            {t.inspector.focusNow} <code data-focus-now>—</code>
          </p>
          <div role="log" aria-live="off" aria-label={t.inspector.logLabels.focus}>
            <ol class="log" data-log="focus" data-empty={t.inspector.empty}></ol>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

{/* One entry per locale so the page ships only its own catalogue. */}
{locale === 'en' && <LabEn />}
{locale === 'es' && <LabEs />}
{locale === 'ar' && <LabAr />}
