---
/**
 * Decorative Storyset illustration. Renders nothing until the SVG is added
 * (see docs/illustrations.md), so layouts never depend on it.
 */
import { illustration, type IllustrationSlot } from '../site/illustrations';

interface Props {
  slot: IllustrationSlot;
  class?: string;
}
const { slot, class: className } = Astro.props;
const svg = illustration(slot);
---

{svg && <figure class:list={['illustration', className]} set:html={svg} />}
