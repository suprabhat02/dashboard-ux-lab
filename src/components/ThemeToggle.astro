---
/** Toggles between dark and light, starting from whatever is currently shown. */
---

<button
  class="icon-btn theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to light theme"
>
  <svg
    class="theme-toggle__sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="theme-toggle__moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const current = (): 'dark' | 'light' => {
    const explicit = root.dataset.theme;
    if (explicit === 'dark' || explicit === 'light') return explicit;
    return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  };
  const sync = (button: HTMLButtonElement): void => {
    const next = current() === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
    button.dataset.current = current();
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-theme-toggle]',
  )) {
    sync(button);
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('dux-theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page view */
      }
      sync(button);
    });
  }
</script>

<style>
  .theme-toggle__sun {
    display: none;
  }
  .theme-toggle[data-current='dark'] .theme-toggle__sun {
    display: block;
  }
  .theme-toggle[data-current='dark'] .theme-toggle__moon {
    display: none;
  }
</style>
