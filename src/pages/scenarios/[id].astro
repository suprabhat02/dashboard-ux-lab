---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { roleLabel } from '../../spec/copy';
import { PLAN_LABEL } from '../../spec/format';
import { SCENARIOS, type Scenario } from '../../spec/scenarios';
import '../../styles/pages.css';

export const getStaticPaths = (() =>
  SCENARIOS.map((scenario, index) => ({
    params: { id: scenario.id },
    props: { scenario, previous: SCENARIOS[index - 1], next: SCENARIOS[index + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  scenario: Scenario;
  previous: Scenario | undefined;
  next: Scenario | undefined;
}

const { scenario, previous, next } = Astro.props;
const { settings, explanation } = scenario;
const failure = { never: 'Never', once: 'First attempt only', always: 'Every attempt' }[
  settings.failure
];
---

<BaseLayout
  title={`${scenario.title}: dashboard scenario guide`}
  description={`${scenario.summary} ${explanation.why}`}
  section="scenarios"
>
  <article class="container doc">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol role="list">
        <li>
          <a href="/scenarios/">Scenario guides</a>
        </li>
        <li>
          <span aria-current="page">{scenario.title}</span>
        </li>
      </ol>
    </nav>
    <h1 class="doc__title">{scenario.title}</h1>
    <p class="doc__lede">{scenario.summary}</p>
    <p>
      <a class="btn btn--primary" href={`/lab/react/?scenario=${scenario.id}`}>
        Try it in the lab
      </a>
    </p>

    <section aria-labelledby="behaviour">
      <h2 id="behaviour">Expected behaviour</h2>
      <p>{explanation.what}</p>
      <dl class="settings-table">
        <div>
          <dt>Server latency</dt>
          <dd>{settings.latencyMs.toLocaleString('en-US')} ms</dd>
        </div>
        <div>
          <dt>Server failure</dt>
          <dd>{failure}</dd>
        </div>
        <div>
          <dt>Visitor role</dt>
          <dd>{roleLabel(settings.role)}</dd>
        </div>
        <div>
          <dt>Plan filter</dt>
          <dd>{PLAN_LABEL[settings.plan]}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="why">
      <h2 id="why">Why it behaves this way</h2>
      <p>{explanation.why}</p>
      <ul>
        {scenario.guidance.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="a11y">
      <h2 id="a11y">Accessibility</h2>
      <p>{explanation.accessibility}</p>
    </section>

    <section aria-labelledby="anti">
      <h2 id="anti">Mistakes this scenario exposes</h2>
      <ul>
        {scenario.antiPatterns.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <nav class="pager" aria-label="More scenarios">
      {previous ? (
        <a href={`/scenarios/${previous.id}/`}>← {previous.title}</a>
      ) : (
        <span />
      )}
      {next && <a href={`/scenarios/${next.id}/`}>{next.title} →</a>}
    </nav>
  </article>
</BaseLayout>
