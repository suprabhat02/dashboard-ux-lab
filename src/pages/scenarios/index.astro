---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SCENARIOS } from '../../spec/scenarios';
import '../../styles/pages.css';
---

<BaseLayout
  title="Scenario guides"
  description="How a dashboard should behave in six real-world scenarios: loaded, loading, slow, empty, error with retry, and restricted access."
  section="scenarios"
>
  <div class="container doc">
    <p class="eyebrow">Guides</p>
    <h1 class="doc__title">Scenario guides</h1>
    <p class="doc__lede">
      Each guide explains one state: what should happen, why, how it is announced, and the
      mistakes it is designed to expose. Every guide links to the live lab with that
      scenario preselected.
    </p>
    <ul class="guide-list" role="list">
      {SCENARIOS.map((scenario) => (
        <li>
          <a class="card guide-card" href={`/scenarios/${scenario.id}/`}>
            <span class="guide-card__title">{scenario.title}</span>
            <span class="guide-card__summary">{scenario.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
