---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SCENARIOS } from '../spec/scenarios';
import '../styles/pages.css';

const stateIcon: Record<string, string> = {
  loaded: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  loading: 'M12 3a9 9 0 1 0 9 9',
  slow: 'M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  empty: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM20 20l-3.5-3.5',
  error:
    'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z',
  restricted: 'M6 11h12v10H6zM8 11V7a4 4 0 0 1 8 0v4',
};
---

<BaseLayout
  title="Dashboard UX Lab — how dashboards should behave when data isn’t perfect"
  description="An interactive lab for dashboard states: loading, slow responses, empty results, failures with retry and restricted access. Built in React and framework-free TypeScript from one shared spec."
  section="home"
>
  <section class="hero container">
    <p class="pill hero__pill">Open source · React now, vanilla next</p>
    <h1 class="hero__title">
      Dashboards spend half their life <span class="hero__accent">not loaded.</span>
    </h1>
    <p class="hero__lede">
      An interactive lab for the states most demos skip: loading, slow, empty, failed and
      forbidden. Break the dashboard on purpose, then see exactly what changed, what a
      screen reader heard and where focus went.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary btn--lg" href="/lab/react/">
        Open the lab
      </a>
      <a class="btn btn--lg" href="/scenarios/">
        Read the scenario guides
      </a>
    </div>

    <ol class="state-strip" role="list" aria-label="The six scenarios">
      {SCENARIOS.map((scenario, index) => (
        <li class="state-strip__item" data-scenario={scenario.id} style={`--i:${index}`}>
          <a href={`/lab/react/?scenario=${scenario.id}`} class="state-strip__link">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={stateIcon[scenario.id]} />
            </svg>
            <span class="state-strip__title">{scenario.title}</span>
            <span class="state-strip__summary">{scenario.summary}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container section" aria-labelledby="how-heading">
    <p class="eyebrow">How it works</p>
    <h2 class="section__title" id="how-heading">
      A playground, not a screenshot
    </h2>
    <div class="feature-grid">
      <article class="card feature">
        <h3>Break it on purpose</h3>
        <p>
          Drag server latency from 0 to 15 seconds, make the API fail once or forever,
          switch the visitor’s role. Every combination follows the same written rules.
        </p>
      </article>
      <article class="card feature">
        <h3>See the invisible parts</h3>
        <p>
          The inspector shows each state transition, every live-region announcement and
          every programmatic focus move: the behaviour that never appears in screenshots.
        </p>
      </article>
      <article class="card feature">
        <h3>Compare two builds fairly</h3>
        <p>
          The same spec, mock API, copy and CSS, implemented separately in React and in
          framework-free TypeScript, checked by one shared test suite. The vanilla build
          is the next milestone.
        </p>
      </article>
    </div>
  </section>

  <section class="container section" aria-labelledby="principles-heading">
    <p class="eyebrow">The rules</p>
    <h2 class="section__title" id="principles-heading">
      Six decisions the lab makes visible
    </h2>
    <ol class="principles">
      <li>
        <strong>No skeleton for fast responses.</strong> Placeholders appear only after
        300ms.
      </li>
      <li>
        <strong>Slow is time, not a state.</strong> The message escalates at 3s; cancel
        appears at 8s.
      </li>
      <li>
        <strong>Empty is an answer, not an error.</strong> It names the filter and offers
        a way out.
      </li>
      <li>
        <strong>Failures are explained and recoverable.</strong> Request ID, one Retry, no
        double submit.
      </li>
      <li>
        <strong>Forbidden is not failed.</strong> No retry for a 403; say who can grant
        access.
      </li>
      <li>
        <strong>Announce once, move focus rarely.</strong> Only when the focused control
        disappears.
      </li>
    </ol>
  </section>

  <section class="container section honest" aria-labelledby="status-heading">
    <h2 class="section__title" id="status-heading">
      Where the project stands
    </h2>
    <p>
      The React implementation, shared spec and automated tests are in place. Manual
      screen reader and real-device testing is in progress and will be published on the{' '}
      <a href="/accessibility/">accessibility page</a>, including known issues. Feedback
      on the spec is the most useful thing you can give:{' '}
      <a href="https://github.com/suprabhat02/dashboard-ux-lab/issues">open an issue</a>.
    </p>
  </section>
</BaseLayout>
