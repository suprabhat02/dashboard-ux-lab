---
/**
 * GitHub Pages serves one 404 for every path, so it can't know the visitor's
 * locale at build time. It renders English and links to every locale's home.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCALE_META, LOCALES, localizePath } from '../spec/i18n';
import { pageI18n } from '../site/i18n';
import '../styles/pages.css';

const { t } = pageI18n('en');
---

<BaseLayout
  locale="en"
  title={t.meta.notFoundTitle}
  description={t.meta.notFoundDescription}
  noindex
>
  <div class="container doc">
    <p class="doc__code">{t.notFound.eyebrow}</p>
    <h1 class="doc__title">{t.notFound.title}</h1>
    <p class="doc__lede">{t.notFound.lede}</p>
    <ul class="guide-list" role="list">
      {LOCALES.map((locale) => (
        <li>
          <a
            class="btn"
            href={localizePath(locale, '/')}
            lang={LOCALE_META[locale].htmlLang}
            dir={LOCALE_META[locale].dir}
          >
            {pageI18n(locale).t.notFound.back} · {LOCALE_META[locale].label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
