---
import DashFallback from '../../../components/DashFallback.astro';
import LabShell from '../../../components/LabShell.astro';
import DashboardAppAr from '../../../impl-react/entries/DashboardAppAr';
import DashboardAppEn from '../../../impl-react/entries/DashboardAppEn';
import DashboardAppEs from '../../../impl-react/entries/DashboardAppEs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../../site/i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t } = pageI18n(locale);
---

<BaseLayout
  locale={locale}
  title={t.meta.labReactTitle}
  description={t.meta.labReactDescription}
  section="lab"
>
  <LabShell implementation="react" locale={locale}>
    {/* One island per locale: each bundles only its own catalogue. */}
    {locale === 'en' && (
      <DashboardAppEn client:only="react">
        <DashFallback slot="fallback" locale={locale} />
      </DashboardAppEn>
    )}
    {locale === 'es' && (
      <DashboardAppEs client:only="react">
        <DashFallback slot="fallback" locale={locale} />
      </DashboardAppEs>
    )}
    {locale === 'ar' && (
      <DashboardAppAr client:only="react">
        <DashFallback slot="fallback" locale={locale} />
      </DashboardAppAr>
    )}
  </LabShell>
</BaseLayout>
