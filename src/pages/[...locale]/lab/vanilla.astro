---
import DashFallback from '../../../components/DashFallback.astro';
import LabShell from '../../../components/LabShell.astro';
import VanillaAr from '../../../components/vanilla-scripts/VanillaAr.astro';
import VanillaEn from '../../../components/vanilla-scripts/VanillaEn.astro';
import VanillaEs from '../../../components/vanilla-scripts/VanillaEs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../../site/i18n';
import { SITE_URL, webApplication } from '../../../site/seo';
import { LOCALE_META } from '../../../spec/i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t, href } = pageI18n(locale);
const app = webApplication({
  url: `${SITE_URL}${href('/lab/vanilla/')}`,
  name: `${t.meta.siteName}: ${t.meta.labVanillaTitle}`,
  description: t.meta.labVanillaDescription,
  inLanguage: LOCALE_META[locale].htmlLang,
});
---

<BaseLayout
  locale={locale}
  title={t.meta.labVanillaTitle}
  description={t.meta.labVanillaDescription}
  section="lab"
  schema={[app]}
>
  <LabShell implementation="vanilla" locale={locale}>
    {/* Server-rendered placeholder; the script swaps in the live dashboard. */}
    <div data-dashboard-root>
      <DashFallback locale={locale} />
    </div>
    {locale === 'en' && <VanillaEn />}
    {locale === 'es' && <VanillaEs />}
    {locale === 'ar' && <VanillaAr />}
  </LabShell>
</BaseLayout>
