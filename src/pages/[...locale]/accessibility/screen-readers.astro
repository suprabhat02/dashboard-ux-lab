---
/**
 * The screen reader test script (Phase 3). The expected speech is computed from
 * the spec (spec/speech-script.ts) and tests/e2e/speech.spec.ts holds both builds
 * to it, so what this page tells a tester to listen for is what the code does.
 * Results come from real runs, recorded in site/at-results.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AT_RUNS, AT_SETUPS, latestResult } from '../../../site/at-results';
import { localePaths, pageI18n, type LocaleProps } from '../../../site/i18n';
import { REPO_URL, SITE_URL } from '../../../site/seo';
import { getFormatter } from '../../../spec/format';
import { LOCALE_META } from '../../../spec/i18n';
import { SCENARIOS } from '../../../spec/scenarios';
import { speechScript, type Heard, type TesterAction } from '../../../spec/speech-script';
import type { ImplementationId } from '../../../spec/types';
import '../../../styles/dashboard.css';
import '../../../styles/pages.css';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t, href } = pageI18n(locale);
const s = t.screenReaders;
const d = t.dashboard;
const fmt = getFormatter(locale);
const builds: readonly ImplementationId[] = ['react', 'vanilla'];

const actionText = (action: TesterAction): string => {
  switch (action) {
    case 'open':
      return s.actions.open;
    case 'replay':
      return s.actions.replay(t.lab.replay);
    case 'retry':
      return s.actions.retry(d.error.retry);
    case 'cancel':
      return s.actions.cancel(d.loading.cancel);
    case 'showAllPlans':
      return s.actions.showAllPlans(d.empty.action);
  }
};
const focusTarget = (item: Extract<Heard, { kind: 'focus' }>): string =>
  item.target === 'title' ? d.focus.heading(d.title) : d.focus.button(d.cancelled.action);
const when = (ms: number): string => s.after(t.lab.ms(fmt.integer(ms)));
const dateFormat = new Intl.DateTimeFormat(LOCALE_META[locale].intl, {
  dateStyle: 'medium',
  timeZone: 'UTC',
});
const resultForm = `${REPO_URL}/issues/new?template=screen-reader-result.yml`;
const translationForm = `${REPO_URL}/issues/new?template=translation-review.yml`;
---

<BaseLayout
  locale={locale}
  title={t.meta.screenReadersTitle}
  description={t.meta.screenReadersDescription}
  section="accessibility"
  breadcrumbs={[
    { name: t.meta.siteName, url: `${SITE_URL}${href('/')}` },
    { name: t.accessibilityPage.title, url: `${SITE_URL}${href('/accessibility/')}` },
    { name: s.title, url: `${SITE_URL}${href('/accessibility/screen-readers/')}` },
  ]}
>
  <div class="container doc sr-script">
    <h1 class="doc__title">{s.title}</h1>
    <p class="doc__lede">{s.lede}</p>
    <p class="sr-script__verified">{s.verified}</p>

    <h2>{s.howTitle}</h2>
    <ol class="sr-script__how">
      {s.how.map((item) => (
        <li>{item}</li>
      ))}
    </ol>

    <h2>{s.setupsTitle}</h2>
    <ul class="bullets">
      {AT_SETUPS.map((setup) => (
        <li>{s.setups[setup]}</li>
      ))}
    </ul>

    <h2 id="script-title">{s.scenariosTitle}</h2>
    {SCENARIOS.map((scenario) => {
      const copy = t.scenarios[scenario.id];
      const steps = speechScript(scenario.id, d);
      return (
        <section class="sr-scenario" aria-labelledby={`sr-${scenario.id}`}>
          <h3 id={`sr-${scenario.id}`}>{copy.title}</h3>
          <p class="sr-scenario__summary">{copy.summary}</p>
          <p class="sr-scenario__open">
            <span>{s.openIn}</span>
            {builds.map((build) => (
              <a href={`${href(`/lab/${build}/`)}?scenario=${scenario.id}`}>
                {t.compare.builds[build].name}
              </a>
            ))}
          </p>
          <ol class="sr-steps">
            {steps.map((step, index) => (
              <li class="sr-step">
                <p class="sr-step__do">
                  <strong>{s.stepLabel(index + 1)}</strong> {actionText(step.action)}
                </p>
                <p class="sr-step__expect">{s.expectLabel}</p>
                {step.heard.length === 0 ? (
                  <p class="sr-step__silence">{s.silence}</p>
                ) : (
                  <ol class="sr-heard">
                    {step.heard.map((item) =>
                      item.kind === 'speech' ? (
                        <li>
                          <span class="sr-heard__when">{when(item.atMs)}</span>
                          <span class="sr-heard__tone">
                            {s.politeness[item.politeness]}
                          </span>
                          <q class="sr-heard__words">{item.message}</q>
                        </li>
                      ) : (
                        <li>
                          <span class="sr-heard__when">{when(item.atMs)}</span>
                          <span class="sr-heard__focus">
                            {s.focusMoves(focusTarget(item))}
                          </span>
                        </li>
                      ),
                    )}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </section>
      );
    })}

    <h2 id="results-title">{s.resultsTitle}</h2>
    {AT_RUNS.length === 0 && <p>{s.noRuns}</p>}
    <div class="table-scroll" role="region" aria-labelledby="results-title" tabindex="0">
      <table class="table sr-results">
        <caption>{s.resultsCaption}</caption>
        <thead>
          <tr>
            <th scope="col" class="table__plain-th">
              {s.setupColumn}
            </th>
            {SCENARIOS.map((scenario) => (
              <th scope="col" class="table__plain-th">
                {t.scenarios[scenario.id].title}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {AT_SETUPS.map((setup) => (
            <tr>
              <th scope="row">{s.setups[setup]}</th>
              {SCENARIOS.map((scenario) => {
                const latest = latestResult(AT_RUNS, setup, scenario.id);
                return latest ? (
                  <td data-outcome={latest.result.outcome}>
                    <a href={latest.run.issue}>{s.outcomes[latest.result.outcome]}</a>
                    <small>
                      <time datetime={latest.run.date}>
                        {dateFormat.format(new Date(`${latest.run.date}T00:00:00Z`))}
                      </time>
                    </small>
                  </td>
                ) : (
                  <td data-outcome="untested">{s.outcomes.untested}</td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="sr-script__cta">
      <a class="btn btn--primary" href={resultForm}>
        {s.submit}
      </a>
    </p>

    <h2>{s.reviewTitle}</h2>
    <p>{s.reviewBody}</p>
    <p>
      <a href={translationForm}>{s.reviewLink}</a>
    </p>
  </div>
</BaseLayout>
