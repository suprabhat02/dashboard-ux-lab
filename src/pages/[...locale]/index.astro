---
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import SectionHead from '../../components/home/SectionHead.astro';
import StateDemo from '../../components/home/StateDemo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../site/i18n';
import { rulerPosition } from '../../site/ruler';
import { SITE_URL, webApplication } from '../../site/seo';
import { LOCALE_META } from '../../spec/i18n';
import { SCENARIOS } from '../../spec/scenarios';
import type { ScenarioId } from '../../spec/types';
import '../../styles/dashboard.css';
import '../../styles/pages.css';
import '../../styles/home.css';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t, href } = pageI18n(locale);
const h = t.home;
const repoUrl = 'https://github.com/suprabhat02/dashboard-ux-lab';
const lastRow = h.comparison.rows.length - 1;
const app = webApplication({
  url: `${SITE_URL}${href('/')}`,
  name: t.meta.siteName,
  description: t.meta.homeDescription,
  inLanguage: LOCALE_META[locale].htmlLang,
});

/** Scenario each closing action opens, in the order of h.cta.actions. */
const BREAKS = ['slow', 'error', 'restricted'] as const satisfies readonly ScenarioId[];

const intl = LOCALE_META[locale].intl;
const ms = new Intl.NumberFormat(intl, {
  style: 'unit',
  unit: 'millisecond',
  unitDisplay: 'narrow',
});
const sec = new Intl.NumberFormat(intl, {
  style: 'unit',
  unit: 'second',
  unitDisplay: 'narrow',
});
const duration = (value: number): string =>
  value < 1000 ? ms.format(value) : sec.format(value / 1000);

/* Tools behind the lab, drawn with devicon (MIT; marks belong to their owners) so
   every logo shares one 128-unit grid. Proper nouns, identical in every language. */
const logos = import.meta.glob<string>('/src/assets/logos/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
});
const logo = (file: string): string => logos[`/src/assets/logos/${file}.svg`] ?? '';
const STACK = [
  { name: 'Astro', logo: logo('astro') },
  { name: 'React', logo: logo('react') },
  { name: 'TypeScript', logo: logo('typescript') },
  { name: 'HTML', logo: logo('html5') },
  { name: 'CSS', logo: logo('css3') },
  { name: 'Node.js', logo: logo('nodejs') },
  { name: 'npm', logo: logo('npm') },
  { name: 'Vitest', logo: logo('vitest') },
  { name: 'Playwright', logo: logo('playwright') },
  { name: 'ESLint', logo: logo('eslint') },
  { name: 'GitHub', logo: logo('github') },
  { name: 'GitHub Actions', logo: logo('github-actions') },
] as const;
---

<BaseLayout
  locale={locale}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  section="home"
  schema={[app]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__intro">
      <h1 class="hero__title" id="hero-title">
        {h.hero.title}
      </h1>
      <div class="hero__aside">
        <p class="hero__lede">{h.hero.lede}</p>
        <p class="hero__actions">
          <a class="btn btn--primary btn--xl" href={href('/lab/react/')}>
            {h.hero.openLab}
          </a>
          <a class="btn btn--xl" href={href('/scenarios/')}>
            {h.hero.readGuides}
          </a>
        </p>
      </div>
    </div>
    <div class="container">
      <StateDemo locale={locale} />
      <p class="hero__facts">{h.hero.facts}</p>
    </div>
  </section>

  <div class="statement-wrap">
    <div class="container">
      <p class="statement">{h.statement}</p>
    </div>
  </div>

  <section class="home-section" aria-labelledby="problem-title">
    <div class="container split">
      <div class="split__text">
        <SectionHead id="problem-title" title={h.problem.title} intro={h.problem.intro} />
        <h3 class="subhead">{h.problem.symptomsTitle}</h3>
        <ul class="bullets symptoms">
          {h.problem.symptoms.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <Illustration slot="problem" class="split__art" />
    </div>
  </section>

  <section class="home-section home-section--tint" aria-labelledby="traditional-title">
    <div class="container">
      <SectionHead
        id="traditional-title"
        title={h.traditional.title}
        intro={h.traditional.intro}
      />
      {/* A real sequence, so it is numbered. */}
      <ol class="tl" role="list">
        {h.traditional.steps.map((step, index) => (
          <li class="tl__item">
            <span class="tl__dot" aria-hidden="true" />
            <div class="tl__head">
              <span class="tl__num" aria-hidden="true">
                {index + 1}
              </span>
              <h3 class="tl__title">{step.title}</h3>
            </div>
            <p class="tl__body">{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="callout">{h.traditional.why}</p>
    </div>
  </section>

  <section class="home-section" aria-labelledby="approach-title">
    <div class="container split split--reverse">
      <div class="split__text">
        <SectionHead
          id="approach-title"
          title={h.approach.title}
          intro={h.approach.intro}
        />
        <ul class="bullets points">
          {h.approach.points.map((point) => (
            <li>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </li>
          ))}
        </ul>
      </div>
      <Illustration slot="approach" class="split__art" />
    </div>
  </section>

  <section class="home-section home-section--flush" aria-labelledby="comparison-title">
    <div class="container">
      <SectionHead
        id="comparison-title"
        title={h.comparison.title}
        intro={h.comparison.intro}
      />
      <div
        class="table-scroll comparison"
        role="region"
        aria-labelledby="comparison-title"
        tabindex="0"
      >
        {/* The heading and introduction above name the table visually; the caption
            gives it a fuller name for assistive technology. */}
        <table class="table">
          <caption class="sr-only">{h.comparison.caption}</caption>
          <thead>
            <tr>
              <th scope="col" class="table__plain-th">
                {h.comparison.columns.tool}
              </th>
              <th scope="col" class="table__plain-th">
                {h.comparison.columns.strength}
              </th>
              <th scope="col" class="table__plain-th">
                {h.comparison.columns.gap}
              </th>
            </tr>
          </thead>
          <tbody>
            {h.comparison.rows.map((row, index) => (
              <tr class:list={{ comparison__ours: index === lastRow }}>
                <th scope="row">{row.tool}</th>
                <td>{row.strength}</td>
                <td>{row.gap}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="home-section home-section--tint" aria-labelledby="scenarios-title">
    <div class="container">
      <SectionHead
        id="scenarios-title"
        title={h.scenariosTitle}
        intro={h.scenariosIntro}
      />
      {/* Each row repeats the hero's ruler in miniature: where its response lands. */}
      <ul class="index" role="list">
        {SCENARIOS.map((scenario) => (
          <li>
            <a
              class="index__row"
              href={`${href('/lab/react/')}?scenario=${scenario.id}`}
              data-scenario={scenario.id}
            >
              <Icon name={scenario.id} size={24} class="index__icon" />
              <span class="index__title">{t.scenarios[scenario.id].title}</span>
              <span class="index__summary">{t.scenarios[scenario.id].summary}</span>
              <span class="index__time">
                <span
                  class="index__ruler"
                  aria-hidden="true"
                  style={`--resp: ${rulerPosition(scenario.settings.latencyMs).toFixed(4)}`}
                />
                <span class="index__ms">{duration(scenario.settings.latencyMs)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-section" aria-labelledby="rules-title">
    <div class="container rules-wrap">
      <SectionHead id="rules-title" title={h.rulesTitle} />
      <ul class="rules" role="list">
        {h.rules.map((rule) => (
          <li class="rules__item">
            <h3 class="rules__lead">{rule.lead}</h3>
            <p>{rule.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-section home-section--flush" aria-labelledby="audience-title">
    <div class="container">
      <SectionHead id="audience-title" title={h.audience.title} />
      <ul class="columns" role="list">
        {h.audience.groups.map((group) => (
          <li>
            <h3>{group.title}</h3>
            <p>{group.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="stack" aria-labelledby="stack-title" data-marquee>
    <div class="container stack__head">
      <h2 class="stack__title" id="stack-title">
        {h.stack.title}
      </h2>
      <button
        class="stack__toggle"
        type="button"
        data-marquee-toggle
        data-label-play={h.stack.play}
        data-label-pause={h.stack.pause}
        aria-label={h.stack.pause}
      >
        <Icon name="pause" size={16} class="stack__icon-pause" />
        <Icon name="play" size={16} class="stack__icon-play" />
      </button>
    </div>
    <div class="stack__viewport">
      <div class="stack__track">
        <ul class="stack__list" role="list">
          {STACK.map((item) => (
            <li class="stack__item">
              <span class="stack__logo">
                <img src={item.logo} alt="" width="32" height="32" decoding="async" />
              </span>
              <span class="stack__name">{item.name}</span>
            </li>
          ))}
        </ul>
        {/* A second copy makes the loop seamless; assistive tech reads the first only. */}
        <ul class="stack__list" role="list" aria-hidden="true">
          {STACK.map((item) => (
            <li class="stack__item">
              <span class="stack__logo">
                <img src={item.logo} alt="" width="32" height="32" decoding="async" />
              </span>
              <span class="stack__name">{item.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="container cta__inner">
      <div class="cta__intro">
        <h2 class="cta__title" id="cta-title">
          {h.cta.title}
        </h2>
        <p class="cta__body">{h.cta.body}</p>
        <p class="hero__actions">
          <a class="btn btn--ink btn--xl" href={href('/lab/react/')}>
            {h.cta.primary}
          </a>
          <a class="btn btn--outline-ink btn--xl" href={repoUrl}>
            {h.cta.secondary}
          </a>
        </p>
      </div>
      <div class="cta__breaks">
        <h3 class="cta__breaks-title" id="cta-breaks-title">
          {h.cta.actionsTitle}
        </h3>
        <ul class="breaks" role="list" aria-labelledby="cta-breaks-title">
          {h.cta.actions.map((action, index) => {
            const scenario = BREAKS[index] ?? 'loaded';
            return (
              <li>
                <a class="break" href={`${href('/lab/react/')}?scenario=${scenario}`}>
                  <Icon name={scenario} size={24} class="break__icon" />
                  <span class="break__label">{action.label}</span>
                  <span class="break__detail">{action.detail}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <section class="status" aria-labelledby="status-title">
    <div class="container status__inner">
      <div class="status__intro">
        <h2 class="status__title" id="status-title">
          {h.statusTitle}
        </h2>
        <p class="status__body">{h.statusBody}</p>
        <p class="status__links">
          <a href={href('/accessibility/')}>{h.statusA11yLink}</a>
          <span class="status__feedback">
            {h.statusFeedback} <a href={`${repoUrl}/issues`}>{h.statusIssueLink}</a>.
          </span>
        </p>
      </div>
      <ol class="roadmap" role="list">
        {h.statusItems.map((item) => (
          <li class="roadmap__item" data-state={item.state}>
            <span class="roadmap__mark" aria-hidden="true">
              <Icon
                name={item.state === 'done' ? 'check' : item.state}
                size={item.state === 'done' ? 14 : 22}
              />
            </span>
            <span class="roadmap__label">{item.label}</span>
            <span class="roadmap__state">{h.statusStates[item.state]}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHome } from '../../site/home';
  initHome();
</script>
