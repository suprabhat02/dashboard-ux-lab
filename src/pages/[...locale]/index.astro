---
import Icon from '../../components/Icon.astro';
import Illustration from '../../components/Illustration.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../site/i18n';
import { SCENARIOS } from '../../spec/scenarios';
import '../../styles/dashboard.css';
import '../../styles/pages.css';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t, href } = pageI18n(locale);
const h = t.home;
const repoIssues = 'https://github.com/suprabhat02/dashboard-ux-lab/issues';
const lastRow = h.comparison.rows.length - 1;
---

<BaseLayout
  locale={locale}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  section="home"
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 class="hero__title" id="hero-title">
        {h.hero.title}
      </h1>
      <p class="hero__lede">{h.hero.lede}</p>
      <p class="hero__actions">
        <a class="btn btn--primary btn--lg" href={href('/lab/react/')}>
          {h.hero.openLab}
        </a>
        <a class="btn btn--lg" href={href('/scenarios/')}>
          {h.hero.readGuides}
        </a>
      </p>
    </div>
    <Illustration slot="hero" class="hero__art" />
  </section>

  <section class="section container split" aria-labelledby="problem-title">
    <div class="split__text">
      <h2 class="section__title" id="problem-title">
        {h.problem.title}
      </h2>
      <p class="section__intro">{h.problem.intro}</p>
      <h3 class="section__subtitle">{h.problem.symptomsTitle}</h3>
      <ul class="symptoms">
        {h.problem.symptoms.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <Illustration slot="problem" class="split__art" />
  </section>

  <section class="section container" aria-labelledby="traditional-title">
    <h2 class="section__title" id="traditional-title">
      {h.traditional.title}
    </h2>
    <p class="section__intro">{h.traditional.intro}</p>
    <ol class="steps">
      {h.traditional.steps.map((step) => (
        <li class="steps__item">
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
    <p class="section__note">{h.traditional.why}</p>
  </section>

  <section
    class="section container split split--reverse"
    aria-labelledby="approach-title"
  >
    <div class="split__text">
      <h2 class="section__title" id="approach-title">
        {h.approach.title}
      </h2>
      <p class="section__intro">{h.approach.intro}</p>
      <ul class="points">
        {h.approach.points.map((point) => (
          <li>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </li>
        ))}
      </ul>
    </div>
    <Illustration slot="approach" class="split__art" />
  </section>

  <section class="section container" aria-labelledby="comparison-title">
    <h2 class="section__title" id="comparison-title">
      {h.comparison.title}
    </h2>
    <p class="section__intro">{h.comparison.intro}</p>
    <div
      class="table-scroll comparison"
      role="region"
      aria-labelledby="comparison-caption"
      tabindex="0"
    >
      <table class="table">
        <caption id="comparison-caption">{h.comparison.caption}</caption>
        <thead>
          <tr>
            <th scope="col" class="table__plain-th">
              {h.comparison.columns.tool}
            </th>
            <th scope="col" class="table__plain-th">
              {h.comparison.columns.strength}
            </th>
            <th scope="col" class="table__plain-th">
              {h.comparison.columns.gap}
            </th>
          </tr>
        </thead>
        <tbody>
          {h.comparison.rows.map((row, index) => (
            <tr class:list={{ comparison__ours: index === lastRow }}>
              <th scope="row">{row.tool}</th>
              <td>{row.strength}</td>
              <td>{row.gap}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section container" aria-labelledby="audience-title">
    <h2 class="section__title" id="audience-title">
      {h.audience.title}
    </h2>
    <ul class="columns">
      {h.audience.groups.map((group) => (
        <li>
          <h3>{group.title}</h3>
          <p>{group.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="scenarios-title">
    <h2 class="section__title" id="scenarios-title">
      {h.scenariosTitle}
    </h2>
    <p class="section__intro">{h.scenariosIntro}</p>
    <ul class="scenario-list">
      {SCENARIOS.map((scenario) => (
        <li>
          <a
            class="scenario-link"
            href={`${href('/lab/react/')}?scenario=${scenario.id}`}
            data-scenario={scenario.id}
          >
            <Icon name={scenario.id} size={22} class="scenario-link__icon" />
            <span class="scenario-link__title">{t.scenarios[scenario.id].title}</span>
            <span class="scenario-link__summary">{t.scenarios[scenario.id].summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="rules-title">
    <h2 class="section__title" id="rules-title">
      {h.rulesTitle}
    </h2>
    <ol class="rules">
      {h.rules.map((rule) => (
        <li>
          <strong>{rule.lead}</strong> {rule.body}
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" aria-labelledby="status-title">
    <h2 class="section__title" id="status-title">
      {h.statusTitle}
    </h2>
    <p class="section__intro">{h.statusBody}</p>
    <p>
      <a href={href('/accessibility/')}>{h.statusA11yLink}</a>. {h.statusFeedback}{' '}
      <a href={repoIssues}>{h.statusIssueLink}</a>.
    </p>
  </section>
</BaseLayout>
