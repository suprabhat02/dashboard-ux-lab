---
/**
 * React and framework-free builds side by side (Phase 2). Each build runs in its
 * own iframe (/embed/<build>/); src/lab/compare/host.ts drives both. Everything
 * measured live is labelled as measured in the visitor's browser; everything
 * else is counted here, at build time, from the source itself.
 */
import { globSync, readFileSync } from 'node:fs';
import Icon from '../../components/Icon.astro';
import CompareAr from '../../components/compare-scripts/CompareAr.astro';
import CompareEn from '../../components/compare-scripts/CompareEn.astro';
import CompareEs from '../../components/compare-scripts/CompareEs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../site/i18n';
import { REPO_URL, SITE_URL, webApplication } from '../../site/seo';
import { getFormatter } from '../../spec/format';
import { LOCALE_META } from '../../spec/i18n';
import { SCENARIOS } from '../../spec/scenarios';
import type { ImplementationId } from '../../spec/types';
import '../../styles/compare.css';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as LocaleProps;
const { t, href } = pageI18n(locale);
const c = t.compare;
const fmt = getFormatter(locale);

/* ── Counted at build time, from the files on disk ──────────────────────── */
// Pages are rendered with the project root as the working directory.
const read = (pattern: string, exclude?: RegExp): readonly string[] =>
  globSync(pattern, { cwd: process.cwd() })
    .filter((path) => !exclude?.test(path))
    .map((path) => readFileSync(path, 'utf8'));
type Sources = readonly string[];
const sources: Record<ImplementationId | 'spec', Sources> = {
  react: read('src/impl-react/**/*.{ts,tsx}'),
  vanilla: read('src/impl-vanilla/**/*.ts'),
  // Catalogues are text, not behaviour; counting them would flatter neither build.
  spec: read('src/spec/**/*.ts', /[\\/]i18n[\\/]/),
};
const lines = (files: Sources): number =>
  files.reduce(
    (sum, text) => sum + text.split('\n').filter((line) => line.trim() !== '').length,
    0,
  );
const builds: readonly {
  id: ImplementationId;
  lines: number;
  files: number;
  deps: readonly string[];
}[] = [
  {
    id: 'react',
    lines: lines(sources.react),
    files: sources.react.length,
    deps: ['react', 'react-dom'],
  },
  {
    id: 'vanilla',
    lines: lines(sources.vanilla),
    files: sources.vanilla.length,
    deps: [],
  },
];

const app = webApplication({
  url: `${SITE_URL}${href('/compare/')}`,
  name: `${t.meta.siteName}: ${t.meta.compareTitle}`,
  description: t.meta.compareDescription,
  inLanguage: LOCALE_META[locale].htmlLang,
});
const divergenceLog = `${REPO_URL}/blob/main/docs/divergence-log.md`;
---

<BaseLayout
  locale={locale}
  title={t.meta.compareTitle}
  description={t.meta.compareDescription}
  section="compare"
  breadcrumbs={[
    { name: t.meta.siteName, url: `${SITE_URL}${href('/')}` },
    { name: t.meta.compareTitle, url: `${SITE_URL}${href('/compare/')}` },
  ]}
  schema={[app]}
>
  <div class="container cmp" data-compare data-agreement="waiting">
    <header class="cmp__intro">
      <h1 class="cmp__title">{c.title}</h1>
      <p class="cmp__lede">{c.lede}</p>
    </header>

    <form class="cmp__controls" data-compare-controls novalidate>
      <fieldset class="cmp__scenarios">
        <legend class="cmp__legend">{c.controlsHeading}</legend>
        <div class="cmp__options">
          {SCENARIOS.map((scenario) => (
            <label class="cmp__option">
              <input
                type="radio"
                name="scenario"
                value={scenario.id}
                checked={scenario.id === 'loaded'}
              />
              <span>{t.scenarios[scenario.id].title}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <button class="btn btn--primary cmp__replay" type="button" data-replay-both>
        <Icon name="retry" size={16} />
        {c.replay}
      </button>
      <fieldset class="cmp__listen">
        <legend class="cmp__legend">{c.listenLegend}</legend>
        <div class="cmp__options">
          {builds.map((build) => (
            <label class="cmp__option">
              <input
                type="radio"
                name="listen"
                value={build.id}
                checked={build.id === 'react'}
              />
              <span>{c.builds[build.id].name}</span>
            </label>
          ))}
        </div>
        <p class="cmp__hint">{c.listenHint}</p>
      </fieldset>
    </form>

    <section class="verdict" aria-labelledby="verdict-title">
      <h2 class="verdict__title" id="verdict-title">
        {c.agreement.heading}
      </h2>
      <p class="verdict__text" data-verdict>
        {c.agreement.waiting}
      </p>
      {/* Only the outcome of a finished run is spoken (host.ts). */}
      <p class="sr-only" role="status" data-verdict-live></p>
      <dl class="verdict__diff" data-diff hidden>
        {builds.map((build) => (
          <div>
            <dt>{c.builds[build.id].name}</dt>
            <dd>
              <code dir="auto" data-diff-step={build.id}></code>
            </dd>
          </div>
        ))}
      </dl>
      <p class="verdict__explain">{c.agreement.explain}</p>
    </section>

    <div class="cmp__builds">
      {builds.map((build) => (
        <section
          class="build"
          data-build={build.id}
          aria-labelledby={`build-${build.id}`}
        >
          <header class="build__head">
            <h2 class="build__name" id={`build-${build.id}`}>
              {c.builds[build.id].name}
            </h2>
            <p class="build__note">{c.builds[build.id].note}</p>
          </header>
          <dl
            class="build__metrics"
            aria-label={c.metrics.label(c.builds[build.id].name)}
          >
            <div>
              <dt>{c.metrics.ready}</dt>
              <dd data-metric="ready">{c.metrics.measuring}</dd>
            </div>
            <div>
              <dt>{c.metrics.script}</dt>
              <dd data-metric="script">{c.metrics.measuring}</dd>
            </div>
            <div>
              <dt>{c.metrics.steps}</dt>
              <dd data-metric="steps">{fmt.integer(0)}</dd>
            </div>
          </dl>
          <p class="build__heard">
            <span>{c.lastHeard}</span> <q data-heard>{c.nothingHeard}</q>
          </p>
          <div class="build__access" data-access>
            <p data-access-on>{c.active}</p>
            <p data-access-off hidden>
              {c.muted}
            </p>
            <button class="btn btn--sm" type="button" data-use-build hidden>
              {c.useThis}
            </button>
          </div>
          <div class="build__frame">
            <iframe
              title={c.builds[build.id].frameTitle}
              data-src={href(`/embed/${build.id}/`)}
            ></iframe>
          </div>
        </section>
      ))}
    </div>
    <p class="cmp__note">{c.measuredNote}</p>

    <section class="cmp__section" aria-labelledby="facts-title">
      <h2 class="cmp__h2" id="facts-title">
        {c.facts.heading}
      </h2>
      <div class="cmp-table" role="region" aria-labelledby="facts-title" tabindex="0">
        <table>
          <caption>{c.facts.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{c.facts.measure}</th>
              {builds.map((build) => (
                <th scope="col">{c.builds[build.id].name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{c.facts.source}</th>
              {builds.map((build) => (
                <td class="mono">{fmt.integer(build.lines)}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">{c.facts.files}</th>
              {builds.map((build) => (
                <td class="mono">{fmt.integer(build.files)}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">{c.facts.deps}</th>
              {builds.map((build) => (
                <td>
                  {build.deps.length === 0 ? (
                    c.facts.none
                  ) : (
                    <code dir="ltr">{build.deps.join(', ')}</code>
                  )}
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="cmp__aside">{c.facts.shared(fmt.integer(lines(sources.spec)))}</p>
    </section>

    <section class="cmp__section" aria-labelledby="harder-title">
      <h2 class="cmp__h2" id="harder-title">
        {c.harder.heading}
      </h2>
      <div class="cmp-table" role="region" aria-labelledby="harder-title" tabindex="0">
        <table>
          <caption>{c.harder.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{c.harder.topic}</th>
              {builds.map((build) => (
                <th scope="col">{c.builds[build.id].name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {c.harder.items.map((item) => (
              <tr>
                <th scope="row">{item.topic}</th>
                <td>{item.react}</td>
                <td>{item.vanilla}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp__aside">
        <a href={divergenceLog}>{c.harder.logLink}</a>
      </p>
    </section>
  </div>

  {locale === 'en' && <CompareEn />}
  {locale === 'es' && <CompareEs />}
  {locale === 'ar' && <CompareAr />}
</BaseLayout>
