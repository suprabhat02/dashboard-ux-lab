---
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePaths, pageI18n, type LocaleProps } from '../../../site/i18n';
import { GUIDES_UPDATED, SITE_URL, techArticle } from '../../../site/seo';
import { getFormatter } from '../../../spec/format';
import { LOCALE_META } from '../../../spec/i18n';
import { SCENARIOS } from '../../../spec/scenarios';
import type { ScenarioId } from '../../../spec/types';
import '../../../styles/pages.css';

interface Props extends LocaleProps {
  id: ScenarioId;
  previous: ScenarioId | undefined;
  next: ScenarioId | undefined;
}

/** Every scenario × every locale: one template, eighteen pages. */
export function getStaticPaths() {
  return localePaths().flatMap(({ params, props }) =>
    SCENARIOS.map((scenario, index) => ({
      params: { ...params, id: scenario.id },
      props: {
        ...props,
        id: scenario.id,
        previous: SCENARIOS[index - 1]?.id,
        next: SCENARIOS[index + 1]?.id,
      },
    })),
  );
}

const { locale, id, previous, next } = Astro.props as Props;
const { t, href } = pageI18n(locale);
const fmt = getFormatter(locale);
const copy = t.scenarios[id];
const position = SCENARIOS.findIndex((scenario) => scenario.id === id) + 1;
const settings = SCENARIOS.find((scenario) => scenario.id === id)?.settings;
const labHref = `${href('/lab/react/')}?scenario=${id}`;
const pageUrl = `${SITE_URL}${href(`/scenarios/${id}/`)}`;
const description = t.meta.guideDescription(copy.summary);
const breadcrumbs = [
  { name: t.meta.siteName, url: `${SITE_URL}${href('/')}` },
  { name: t.guides.title, url: `${SITE_URL}${href('/scenarios/')}` },
  { name: copy.title, url: pageUrl },
];
const article = techArticle({
  url: pageUrl,
  headline: copy.title,
  description,
  inLanguage: LOCALE_META[locale].htmlLang,
  image: `${SITE_URL}/og/${locale}.png`,
  dateModified: GUIDES_UPDATED,
});
---

<BaseLayout
  locale={locale}
  title={t.meta.guideTitle(copy.title)}
  description={description}
  section="scenarios"
  ogType="article"
  breadcrumbs={breadcrumbs}
  schema={[article]}
>
  <article class="container guide" data-scenario={id}>
    <header class="guide__head">
      <nav aria-label={t.guides.breadcrumb} class="breadcrumb">
        <ol role="list">
          <li>
            <a href={href('/scenarios/')}>{t.guides.title}</a>
          </li>
          <li>
            <span aria-current="page">{copy.title}</span>
          </li>
        </ol>
      </nav>
      <p class="guide__position">
        <Icon name={id} size={22} class="guide__icon" />
        {t.guides.position(position, SCENARIOS.length)}
      </p>
      <h1 class="guide__title">{copy.title}</h1>
      <p class="guide__lede">{copy.summary}</p>
      <p class="guide__actions">
        <a class="btn btn--primary btn--lg" href={labHref}>
          {t.guides.tryIt}
          <Icon name="arrow" size={18} />
        </a>
      </p>
    </header>

    <div class="guide__layout">
      <div class="guide__body">
        <section class="guide__section" aria-labelledby="behaviour">
          <h2 id="behaviour">{t.guides.behaviour}</h2>
          <p>{copy.what}</p>
        </section>

        <section class="guide__section" aria-labelledby="why">
          <h2 id="why">{t.guides.why}</h2>
          <p>{copy.why}</p>
          <ul class="bullets">
            {copy.guidance.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="guide__section" aria-labelledby="a11y">
          <h2 id="a11y">{t.guides.accessibility}</h2>
          <p>{copy.accessibility}</p>
        </section>

        <section class="guide__section" aria-labelledby="anti">
          <h2 id="anti">{t.guides.antiPatterns}</h2>
          <ul class="bullets">
            {copy.antiPatterns.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="guide__aside" aria-labelledby="settings-title">
        {settings && (
          <div class="guide-panel">
            <h2 class="guide-panel__title" id="settings-title">
              {t.guides.settingsTitle}
            </h2>
            <dl class="settings-list">
              <div>
                <dt>{t.guides.settings.latency}</dt>
                <dd>{t.lab.ms(fmt.integer(settings.latencyMs))}</dd>
              </div>
              <div>
                <dt>{t.guides.settings.failure}</dt>
                <dd>{t.guides.failureValues[settings.failure]}</dd>
              </div>
              <div>
                <dt>{t.guides.settings.role}</dt>
                <dd>{t.dashboard.roles[settings.role]}</dd>
              </div>
              <div>
                <dt>{t.guides.settings.plan}</dt>
                <dd>{t.dashboard.plans[settings.plan]}</dd>
              </div>
            </dl>
            <a class="btn btn--primary guide-panel__cta" href={labHref}>
              {t.guides.tryIt}
              <Icon name="arrow" size={18} />
            </a>
          </div>
        )}
        <nav class="guide-nav" aria-labelledby="all-scenarios">
          <h2 class="guide-panel__title" id="all-scenarios">
            {t.guides.allScenarios}
          </h2>
          <ol role="list">
            {SCENARIOS.map((scenario) => (
              <li>
                <a
                  href={href(`/scenarios/${scenario.id}/`)}
                  aria-current={scenario.id === id ? 'page' : undefined}
                  data-scenario={scenario.id}
                >
                  <Icon name={scenario.id} size={18} />
                  {t.scenarios[scenario.id].title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    </div>

    <nav class="pager" aria-label={t.guides.more}>
      {previous ? (
        <a href={href(`/scenarios/${previous}/`)} class="pager__link pager__link--prev">
          <span class="pager__dir">
            <span class="pager__back" aria-hidden="true">
              <Icon name="arrow" size={16} />
            </span>
            {t.guides.previous}
          </span>
          <span class="pager__title">{t.scenarios[previous].title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={href(`/scenarios/${next}/`)} class="pager__link pager__link--next">
          <span class="pager__dir">
            {t.guides.next}
            <Icon name="arrow" size={16} />
          </span>
          <span class="pager__title">{t.scenarios[next].title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
