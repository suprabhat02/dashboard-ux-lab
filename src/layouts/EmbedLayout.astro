---
/**
 * A bare document for one build, framed by the comparison page: no header,
 * footer or site navigation, never indexed. It still carries its own language,
 * direction, theme and a heading, because an iframe is a document of its own
 * to a screen reader.
 */
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource-variable/noto-kufi-arabic/wght.css';
import '../styles/base.css';
import '../styles/tokens.css';
import '../styles/dashboard.css';
import '../styles/embed.css';
import ThemeScript from '../components/ThemeScript.astro';
import { TELEMETRY_EVENT } from '../spec/protocol';
import { pageI18n } from '../site/i18n';
import type { Locale } from '../spec/i18n';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const { t, dir, htmlLang } = pageI18n(locale);
---

<!doctype html>
<html lang={htmlLang} dir={dir} data-locale={locale} class="embed">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before anything else: holds early telemetry until the bridge module runs. */}
    <script is:inline define:vars={{ type: TELEMETRY_EVENT }}>
      (function () {
        var events = [];
        var keep = function (event) {
          events.push(event.detail);
        };
        window.addEventListener(type, keep);
        window.__duxEarly = {
          events: events,
          stop: function () {
            window.removeEventListener(type, keep);
          },
        };
      })();
    </script>
    <ThemeScript />
    <title>{`${title} · ${t.meta.siteName}`}</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="../lab/entries/bridge.ts"></script>
  </head>
  <body>
    <main id="main">
      <h1 class="sr-only">{title}</h1>
      <slot />
    </main>
  </body>
</html>
