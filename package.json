{
  "name": "dashboard-ux-lab",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive lab for how dashboards should behave when data isn't perfect \u2014 loading, slow, empty, error and restricted states \u2014 built twice, in React and framework-free TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "Suprabhat Kumar (https://suprabhat-dev.com)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/collect-exported-tests.mjs && playwright test",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "astro": "7.3.8",
    "lucide": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
